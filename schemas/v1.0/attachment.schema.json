{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://synthetic-engram.org/schema/v1.0/attachment.schema.json",
  "title": "Synthetic Engram attachment metadata",
  "type": "object",
  "required": ["id", "schema_version", "type", "filename", "media_type", "size", "sha256", "path"],
  "properties": {
    "id": {"$ref": "definitions.schema.json#/$defs/id"}, "schema_version": {"const": "1.0"}, "type": {"const": "attachment"},
    "filename": {"type": "string", "minLength": 1, "pattern": "^[^/\\\\]+$"},
    "media_type": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "size": {"type": "integer", "minimum": 0}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "path": {"$ref": "definitions.schema.json#/$defs/safePath"}, "extensions": {"$ref": "definitions.schema.json#/$defs/extensions"}
  }, "additionalProperties": false
}
