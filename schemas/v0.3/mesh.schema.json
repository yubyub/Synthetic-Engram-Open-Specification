{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engram Mesh 0.3 mesh document",
  "type": "object",
  "required": ["format", "version", "mesh_id", "sources", "nodes", "bindings", "relationships"],
  "properties": {
    "format": {"const": "engram-mesh"},
    "version": {"const": "0.3"},
    "mesh_id": {"$ref": "definitions.schema.json#/$defs/id"},
    "generated_at": {"type": "string", "format": "date-time"},
    "sources": {
      "type": "array",
      "items": {"$ref": "#/$defs/source"}
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/node"}
    },
    "bindings": {
      "type": "array",
      "items": {"$ref": "#/$defs/binding"}
    },
    "relationships": {
      "type": "array",
      "items": {"$ref": "#/$defs/relationship"}
    },
    "slices": {
      "type": "array",
      "items": {"$ref": "#/$defs/slice"}
    },
    "lenses": {
      "type": "array",
      "items": {"$ref": "#/$defs/lens"}
    },
    "extensions": {"$ref": "definitions.schema.json#/$defs/extensions"}
  },
  "additionalProperties": false,
  "$defs": {
    "capability": {
      "type": "string",
      "pattern": "^(discover|read|create|modify|move|delete|[a-z0-9]+(\\.[a-z0-9-]+)+\\.[a-z0-9-]+)$"
    },
    "source": {
      "type": "object",
      "required": ["id", "kind", "identity_domain", "capabilities"],
      "properties": {
        "id": {"$ref": "definitions.schema.json#/$defs/id"},
        "kind": {"type": "string", "minLength": 1},
        "identity_domain": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "resolver": {
          "type": "object",
          "required": ["mechanism", "locator"],
          "properties": {
            "mechanism": {"type": "string", "minLength": 1},
            "locator": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}, "uniqueItems": true},
        "extensions": {"$ref": "definitions.schema.json#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": {"$ref": "definitions.schema.json#/$defs/id"},
        "type": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "extensions": {"$ref": "definitions.schema.json#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "freshness": {
      "type": "object",
      "required": ["observed_at"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "revision": {"type": "string", "minLength": 1},
        "digest": {"type": "string", "minLength": 1},
        "token": {"type": "string", "minLength": 1}
      },
      "anyOf": [{"required": ["revision"]}, {"required": ["digest"]}, {"required": ["token"]}],
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": ["id", "node", "source", "external_id", "object_generation", "state", "authority"],
      "properties": {
        "id": {"$ref": "definitions.schema.json#/$defs/id"},
        "node": {"$ref": "definitions.schema.json#/$defs/id"},
        "source": {"$ref": "definitions.schema.json#/$defs/id"},
        "external_id": {"type": "string", "minLength": 1},
        "object_generation": {"type": "string", "minLength": 1},
        "state": {"enum": ["active", "superseded", "deleted", "unresolved"]},
        "authority": {"enum": ["authoritative", "replica", "reference"]},
        "successor": {"$ref": "definitions.schema.json#/$defs/id"},
        "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}, "uniqueItems": true},
        "freshness": {"$ref": "#/$defs/freshness"},
        "extensions": {"$ref": "definitions.schema.json#/$defs/extensions"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "superseded"}}}, "then": {"required": ["successor"]}},
        {"if": {"properties": {"state": {"enum": ["deleted", "unresolved"]}}}, "then": {"not": {"required": ["capabilities"]}}}
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "required": ["id", "from", "to", "type"],
      "properties": {
        "id": {"$ref": "definitions.schema.json#/$defs/id"},
        "from": {"$ref": "definitions.schema.json#/$defs/id"},
        "to": {"$ref": "definitions.schema.json#/$defs/id"},
        "type": {"type": "string", "minLength": 1},
        "extensions": {"$ref": "definitions.schema.json#/$defs/extensions"}
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["mechanism", "description"],
      "properties": {
        "mechanism": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "expression": {"type": "string"},
        "description": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "boundary": {
      "type": "object",
      "required": ["kind", "disposition"],
      "properties": {
        "kind": {"enum": ["node", "relationship"]},
        "id": {"$ref": "definitions.schema.json#/$defs/id"},
        "disposition": {"enum": ["omitted", "unresolved", "undisclosed"]},
        "reason": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"disposition": {"const": "undisclosed"}}}, "then": {"not": {"required": ["id"]}}, "else": {"required": ["id"]}}
      ],
      "additionalProperties": false
    },
    "slice": {
      "type": "object",
      "required": ["id", "scope", "selection", "sources", "nodes", "bindings", "relationships", "boundary"],
      "properties": {
        "id": {"$ref": "definitions.schema.json#/$defs/id"},
        "scope": {"enum": ["complete", "partial"]},
        "snapshot": {"type": "string", "minLength": 1},
        "selection": {"$ref": "#/$defs/selection"},
        "sources": {"type": "array", "items": {"$ref": "definitions.schema.json#/$defs/id"}, "uniqueItems": true},
        "nodes": {"type": "array", "items": {"$ref": "definitions.schema.json#/$defs/id"}, "uniqueItems": true},
        "bindings": {"type": "array", "items": {"$ref": "definitions.schema.json#/$defs/id"}, "uniqueItems": true},
        "relationships": {"type": "array", "items": {"$ref": "definitions.schema.json#/$defs/id"}, "uniqueItems": true},
        "boundary": {"type": "array", "items": {"$ref": "#/$defs/boundary"}}
      },
      "allOf": [{"if": {"properties": {"scope": {"const": "complete"}}}, "then": {"required": ["snapshot"]}}],
      "additionalProperties": false
    },
    "lens": {
      "type": "object",
      "required": ["id", "mechanism", "version", "expression"],
      "properties": {
        "id": {"$ref": "definitions.schema.json#/$defs/id"},
        "mechanism": {"type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"},
        "version": {"type": "string", "minLength": 1},
        "expression": {"type": "string"},
        "extensions": {"$ref": "definitions.schema.json#/$defs/extensions"}
      },
      "additionalProperties": false
    }
  }
}
