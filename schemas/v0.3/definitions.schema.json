{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}_[0-9A-HJKMNP-TV-Z]{26}$"},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"}, "additionalProperties": true}
  }
}
