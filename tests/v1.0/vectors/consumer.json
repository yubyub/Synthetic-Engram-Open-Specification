    {
      "id": "CONSUMER-001",
      "requirement": "REQ-INV-006",
      "adapter_operation": "consume",
      "fixture": {
        "kind": "directory",
        "source": "tests/v1.0/valid/basic-engram",
        "steps": [
          {
            "action": "write-text",
            "path": "scratch.tmp",
            "content": "not inventoried\n"
          }
        ]
      },
      "parameters": {
        "task": "inventory"
      },
      "expected": {
        "status": "success",
        "normative_object_ids_exclude_unlisted": true
      }
    },
    {
      "id": "CONSUMER-002",
      "requirement": "REQ-CONF-003",
      "adapter_operation": "consume",
      "fixture": {
        "kind": "directory",
        "source": "tests/v1.0/valid/empty-graph"
      },
      "supported_profiles": [
        "core"
      ],
      "parameters": {
        "task": "import"
      },
      "expected": {
        "status": "unsupported-profile",
        "profile": "graph",
        "must_not_report_success": true
      }
    },
    {
